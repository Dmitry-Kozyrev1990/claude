# Секрет для подписи сессий: openssl rand -hex 32
DOLKA_SECRET=
# Путь к базе SQLite
DOLKA_DB=data/dolka.sqlite3
# demo — тестовая активация без списания денег; yookassa — ЮKassa; off — оплата выключена
DOLKA_PAYMENTS=demo
# 1 — cookie только по HTTPS (включить на сервере)
DOLKA_SECURE_COOKIES=0
DOLKA_PUBLIC_URL=http://localhost:8000
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
