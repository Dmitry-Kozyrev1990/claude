# Домен сайта (A-запись домена должна указывать на IP сервера). Без домена: DOMAIN=:80
DOMAIN=lotline.example.ru

# Секрет для сессий: длинная случайная строка. Сгенерировать: openssl rand -hex 32
LOTLINE_SECRET=

# Почта администратора: зарегистрируйтесь с ней на сайте — появится раздел «Администрирование».
LOTLINE_ADMIN_EMAILS=you@example.ru

# Оплата: demo — тестовая активация подписки без списания денег; off — оплата выключена;
# yookassa — после подключения ЮKassa.
LOTLINE_PAYMENTS=demo

# 1 — сайт работает по HTTPS (с доменом); 0 — по HTTP (без домена).
LOTLINE_SECURE_COOKIES=1
LOTLINE_PUBLIC_URL=https://lotline.example.ru

# ЮKassa — заполнить при подключении оплаты.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
